{
  "Database": {
    "ConnectionString": "Data Source=data/round-table-meeting.db;Mode=ReadWriteCreate;Default Timeout=5;Foreign Keys=True;Pooling=True"
  },
  "MeetingJoinRateLimit": {
    "WindowSeconds": 300,
    "PerUserLimit": 30,
    "PerSourceLimit": 100
  },
  "RealtimeChat": {
    "MaxContentLength": 16384,
    "HistoryPageSize": 100,
    "MaxHistoryPageSize": 200,
    "GateCloseTimeoutSeconds": 5,
    "PresenceDisconnectGraceSeconds": 5,
    "EventDispatcherBatchSize": 50,
    "EventLeaseSeconds": 30,
    "EventRetryBaseSeconds": 2,
    "EventRetryMaxSeconds": 300,
    "EventRetryAlertAfterAttempts": 10,
    "SendRateLimit": {
      "WindowSeconds": 60,
      "PerUserLimit": 120,
      "PerParticipantLimit": 60,
      "PerSourceLimit": 200
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Fatal",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
